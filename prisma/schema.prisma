// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Direction {
  MARKETING
  IT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id              String        @id @default(cuid())
  direction       Direction
  name            String
  email           String
  phone           String
  answers         Json
  comment         String?
  slotAt          DateTime
  status          BookingStatus @default(PENDING)
  calendarEventId String?
  reminderSent    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slotAt])
  @@index([status])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Post {
  id            String     @id @default(cuid())
  slug          String     @unique
  status        PostStatus @default(DRAFT)
  coverImageUrl String?
  title         Json // { "ru": "...", "en": "..." }
  excerpt       Json // { "ru": "...", "en": "..." }
  content       Json // { "ru": "...(markdown)...", "en": "..." }
  tags          String[]   @default([])
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
}

model CalendarChannel {
  id         String   @id @default(cuid())
  channelId  String   @unique
  resourceId String
  syncToken  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
