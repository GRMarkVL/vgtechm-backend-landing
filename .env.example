# =============================================================================
# vgtechm-backend-landing — пример переменных окружения
# Скопируй в .env (`cp .env.example .env`) и заполни значения.
# .env закоммичен в .gitignore — никогда не пушь его в git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Локально — отдельная dev-БД (НЕ prod!).
# Параметры запроса: schema, timezone желательно Asia/Almaty,
# statement_timeout защищает от подвисших запросов.
DATABASE_URL="postgresql://postgres:password@host:5432/vgtechm-dev?schema=public&statement_timeout=60000&timezone=Asia/Almaty"

# -----------------------------------------------------------------------------
# Google Calendar OAuth (для записи событий и FreeBusy)
# -----------------------------------------------------------------------------
# Создаётся в Google Cloud Console → Credentials → OAuth client (Web app).
# Authorized redirect URI: http://127.0.0.1:53682/oauth2callback (для скрипта gcal:auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# Получается один раз через `npm run gcal:auth` (запускается локально,
# авторизация под аккаунтом владельца календаря, например markgrigorovich1@gmail.com).
# Живёт бессрочно если OAuth-приложение опубликовано (Published), иначе 7 дней.
GOOGLE_REFRESH_TOKEN=

# Какой календарь использовать. `primary` = основной у владельца refresh-токена.
GOOGLE_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# Google Calendar Push Notifications (webhook Calendar → бэк)
# -----------------------------------------------------------------------------
# Публичный HTTPS-URL нашего endpoint. На локалке оставь пустым (sync отключён),
# либо подними ngrok и подставь его URL.
GOOGLE_WEBHOOK_URL=https://api.vgtechm.com/calendar/webhook

# Random 32-байтный hex. Сгенерь: `openssl rand -hex 32`.
# Должен быть РАЗНЫМ для dev и prod. Прокидывается в Google при регистрации
# канала; Google потом возвращает его в каждом колбэке для авторизации.
GOOGLE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Telegram (бот-админка для исполнителя)
# -----------------------------------------------------------------------------
# Токен от @BotFather (формат: 123456:ABC...).
TELEGRAM_BOT_TOKEN=

# Chat ID админов (узнать через @userinfobot). Несколько — через запятую.
# Все админы должны сначала сами нажать /start в чате с ботом,
# иначе Telegram запретит боту писать им первым.
TELEGRAM_ADMIN_CHAT_ID=

# -----------------------------------------------------------------------------
# Resend (email-рассылка)
# -----------------------------------------------------------------------------
# API-ключ с resend.com → API Keys → Create (Full access, Production).
RESEND_API_KEY=

# Адрес отправителя. На sandbox: `onboarding@resend.dev` (отправляет только
# на email владельца аккаунта). Для прода — верифицированный домен.
RESEND_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Разрешённые origin-ы фронтенда. Несколько — через запятую. Пустое = CORS off.
FRONTEND_URL=http://localhost:3000,https://vgtechm.com

# -----------------------------------------------------------------------------
# Blog admin (защита админ-эндпоинтов /admin/blog общим ключом)
# -----------------------------------------------------------------------------
# Сгенерь: `openssl rand -hex 32`. Передаётся фронт-админкой в заголовке x-admin-key.
ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Публичный URL самого бэкенда (для ссылок на картинки блога через media-прокси).
# Локально: http://localhost:4005, в проде: https://api.vgtechm.com
# -----------------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:4005

# -----------------------------------------------------------------------------
# MinIO / S3 (хранилище обложек и картинок блога)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=storage.fittobefreetest.kz
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kontentzavod-test
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Опционально. По умолчанию 4005.
# PORT=4005
